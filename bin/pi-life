#!/usr/bin/env bash
# Launch a Pi harness life from the target repo (cwd).
# INV-skills: -e damage-control-continue, always --no-skills, then --skill for allowlisted paths only.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pi-life [--dry-run] <life> [solo|chain|team]
       pi-life doctor [life]
       pi-life doctor-probe
       pi-life --dump-overlay <cwd>
       pi-life --help

Lives: rust | elixir | ruby | python
Aliases: phoenix → elixir, rails → ruby

  solo   daily stack (default)
  chain  plan-build-review
  team   dispatcher
  doctor this machine + cwd overlay (optional life checks its packs)

Harness root: MY_PI_AGENT_HOME or the directory that contains this script.
Skills root: PI_SKILLS_HOME or ~/.agents/skills.
Run from the target repo. Does not require a justfile there.
EOF
}

# Issue #18: required core.excludesfile patterns
REQUIRED_EXCLUDES=("node_modules" ".pi/agent-sessions/" ".env" "graphify-out/" ".codegraph/")

# Probe git's core.excludesfile in the cwd.
# Returns 0 if the file exists and contains every REQUIRED_EXCLUDES pattern.
# Returns 1 if the file is missing or any required pattern is absent.
# Read-only: never writes to disk or git config.
check_excludesfile() {
  local path
  path="$(git config --get core.excludesfile 2>/dev/null || true)"
  if [[ -z "${path}" || ! -f "${path}" ]]; then
    printf 'excludesfile: %s missing patterns: %s\n' "${path:-<unset>}" "$(IFS=,; echo "${REQUIRED_EXCLUDES[*]}")"
    return 1
  fi
  local missing=()
  local pat
  for pat in "${REQUIRED_EXCLUDES[@]}"; do
    grep -Fxq -- "${pat}" "${path}" || missing+=("${pat}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    printf 'excludesfile: %s missing patterns: %s\n' "${path}" "$(IFS=,; echo "${missing[*]}")"
    return 1
  fi
  printf 'excludesfile: %s ok\n' "${path}"
  return 0
}

resolve_root() {
  if [[ -n "${MY_PI_AGENT_HOME:-}" ]]; then
    printf '%s\n' "${MY_PI_AGENT_HOME}"
    return
  fi
  local src="${BASH_SOURCE[0]}"
  while [[ -L "${src}" ]]; do
    local dir
    dir="$(cd "$(dirname "${src}")" && pwd)"
    src="$(readlink "${src}")"
    [[ "${src}" != /* ]] && src="${dir}/${src}"
  done
  cd "$(dirname "${src}")/.." && pwd
}

canonical_life() {
  case "${1}" in
    rust) printf '%s\n' rust ;;
    elixir|phoenix) printf '%s\n' elixir ;;
    ruby|rails) printf '%s\n' ruby ;;
    python) printf '%s\n' python ;;
    rails-python)
      printf 'pi-life: rails-python is not a life; use ruby or python\n' >&2
      return 2
      ;;
    ecto)
      printf 'pi-life: ecto is not a life; use elixir\n' >&2
      return 2
      ;;
    *) return 1 ;;
  esac
}

# One Bun parse. Prints "kind<TAB>name" rows. Exit 2 on invalid YAML.
read_profile() {
  local file="$1" root="$2"
  (
    cd "${root}"
    bun -e '
      import { parse } from "yaml";
      import { readFileSync } from "node:fs";
      let doc;
      try {
        doc = parse(readFileSync(process.argv[1], "utf8"));
      } catch (e) {
        console.error("pi-life: invalid profile YAML: " + (e instanceof Error ? e.message : String(e)));
        process.exit(2);
      }
      if (doc == null || typeof doc !== "object" || Array.isArray(doc)) {
        console.error("pi-life: invalid profile YAML: expected a mapping");
        process.exit(2);
      }
      const list = (k) => {
        const v = doc[k];
        if (v == null) return [];
        const arr = Array.isArray(v) ? v : [v];
        const out = [];
        for (const item of arr) {
          if (typeof item !== "string") {
            console.error("pi-life: invalid profile YAML: " + k + " must be a string or list of strings");
            process.exit(2);
          }
          if (item) out.push(item);
        }
        return out;
      };
      for (const n of list("mantra")) console.log("mantra\t" + n);
      for (const n of list("packs")) console.log("pack\t" + n);
      const tracker = list("tracker")[0];
      if (tracker && tracker !== "none") console.log("tracker\t" + tracker);
    ' "${file}"
  )
}

# Issue #11: read the project overlay (<cwd>/.pi/capabilities.yaml), if present,
# and print it as a single JSON line on stdout. Missing file = all off (print
# EMPTY_OVERLAY). Malformed YAML or schema = exit 2 (fail closed per issue).
#
# The script path is resolved from BASH_SOURCE[0] so MY_PI_AGENT_HOME overrides
# (used in tests to point at a custom profiles/ dir) do not break the import.
# The module specifier is passed via env var (OVERLAY_MODULE) so paths with
# single quotes or other JS-significant characters are safe.
# The cwd is resolved to an absolute path before the subshell cd's, so
# `--dump-overlay .` (or any relative path) finds the caller's overlay,
# not the harness's.
read_overlay() {
  local cwd_raw="$1"
  local cwd
  cwd="$(cd "${cwd_raw}" 2>/dev/null && pwd)" || {
    printf 'pi-life: --dump-overlay cwd does not exist: %s\n' "${cwd_raw}" >&2
    return 2
  }
  local script
  script="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/extensions/capabilities.ts"
  # Fast path: no overlay file = all off. Avoids the bun spawn on the common
  # no-overlay launch. EMPTY_OVERLAY is the canonical all-off payload; the
  # bun path below produces the same value for verification.
  if [[ ! -f "${cwd}/.pi/capabilities.yaml" ]]; then
    printf '%s\n' '{"capabilities":{"graphify":false,"codegraph":false,"serena":false,"rs-guard":false,"obscura":false,"playwright":false},"extraSkills":[],"trackerSkill":null}'
    return 0
  fi
  (
    cd "$(dirname "${script}")/.."
    OVERLAY_MODULE="${script}" bun -e '
      import { parse } from "yaml";
      import { readFileSync } from "node:fs";
      const mod = await import(process.env.OVERLAY_MODULE);
      const { serializeOverlayEnv, parseOverlayDoc, OverlayParseError } = mod;
      const cwd = process.argv[1];
      const overlayPath = `${cwd}/.pi/capabilities.yaml`;
      let doc;
      try {
        doc = parse(readFileSync(overlayPath, "utf8"));
      } catch (e) {
        console.error("pi-life: invalid overlay YAML: " + (e instanceof Error ? e.message : String(e)));
        process.exit(2);
      }
      let overlay;
      try {
        overlay = parseOverlayDoc(doc);
      } catch (e) {
        if (e instanceof OverlayParseError) {
          console.error("pi-life: " + e.message);
          process.exit(2);
        }
        throw e;
      }
      process.stdout.write(serializeOverlayEnv(overlay) + "\n");
    ' "${cwd}"
  )
}

# Globals: skill_names, pi_args
# required=1 fail closed; required=0 warn and continue
add_named_skill() {
  local required="$1" kind="$2" name="$3" skills_home="$4"
  [[ -z "${name}" ]] && return 0
  case " ${skill_names} " in
    *" ${name} "*) return 0 ;;
  esac
  skill_names="${skill_names} ${name}"

  local path="${skills_home}/${name}"
  if [[ -e "${path}" ]]; then
    pi_args+=(--skill "${path}")
    return 0
  fi
  if [[ "${required}" -eq 1 ]]; then
    printf 'pi-life: missing required %s %s (%s)\n' "${kind}" "${name}" "${path}" >&2
    exit 2
  fi
  printf 'pi-life: warning: missing %s %s (%s)\n' "${kind}" "${name}" "${path}" >&2
}

# Issue #11: add a skill path that came from the overlay (extra_skills or
# tracker.skill). These are local paths, resolved relative to the target repo
# cwd. They are always optional (warn, don't fail) because the overlay is
# per-repo and may point to paths that haven't been created yet.
add_overlay_skill() {
  local kind="$1" path="$2"
  [[ -z "${path}" ]] && return 0
  if [[ -e "${path}" ]]; then
    pi_args+=(--skill "${path}")
    return 0
  fi
  printf 'pi-life: warning: missing overlay %s (%s)\n' "${kind}" "${path}" >&2
}

# Issue #11: list the overlay skill paths (extra_skills + tracker.skill) as
# absolute paths, one per line on stdout. Empty output = no overlay skills.
# Reads PI_OVERLAY from the environment (set by launch_life). Uses bun + the
# capabilities module to deserialize; resolves relative paths against $1.
overlay_skill_paths() {
  local overlay_cwd="$1"
  local script
  script="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/extensions/capabilities.ts"
  (
    cd "$(dirname "${script}")/.."
    OVERLAY_MODULE="${script}" OVERLAY_CWD="${overlay_cwd}" bun -e '
      const { isAbsolute, join } = await import("node:path");
      const mod = await import(process.env.OVERLAY_MODULE);
      const { deserializeOverlayEnv } = mod;
      const overlay = deserializeOverlayEnv(process.env.PI_OVERLAY || "");
      const cwd = process.env.OVERLAY_CWD;
      const resolve = (p) => isAbsolute(p) ? p : join(cwd, p);
      for (const s of overlay.extraSkills) process.stdout.write(resolve(s) + "\n");
      if (overlay.trackerSkill) process.stdout.write(resolve(overlay.trackerSkill) + "\n");
    '
  )
}

launch_life() {
  local root="$1" life="$2" mode="$3" dry_run="$4"
  local profile="${root}/profiles/${life}.yaml"
  if [[ ! -f "${profile}" ]]; then
    printf 'pi-life: missing profile %s\n' "${profile}" >&2
    exit 2
  fi

  if ! command -v bun >/dev/null 2>&1; then
    printf 'pi-life: bun not found on PATH (needed to read YAML profiles)\n' >&2
    exit 2
  fi

  local skills_home="${PI_SKILLS_HOME:-${HOME}/.agents/skills}"
  skill_names=""
  pi_args=(-e "${root}/extensions/damage-control-continue.ts" -e "${root}/extensions/capabilities.ts" -e "${root}/extensions/clarify-gate.ts" --no-skills)
  if [[ "${mode}" == "solo" ]]; then
    pi_args+=(-e "${root}/extensions/status-line.ts")
  fi

  local rows
  rows="$(read_profile "${profile}" "${root}")" || exit 2
  local kind name
  while IFS=$'\t' read -r kind name; do
    [[ -z "${kind}" ]] && continue
    case "${kind}" in
      mantra) add_named_skill 1 mantra "${name}" "${skills_home}" ;;
      pack) add_named_skill 0 pack "${name}" "${skills_home}" ;;
      tracker) add_named_skill 1 tracker "${name}" "${skills_home}" ;;
    esac
  done <<<"${rows}"

  # Issue #11: read the project overlay and export it to the capabilities
  # extension as PI_OVERLAY. Missing file = empty overlay; bad YAML = exit 2.
  local overlay
  overlay="$(read_overlay "${PWD}")" || exit 2
  export PI_OVERLAY="${overlay}"
  export MY_PI_AGENT_HOME="${root}"
  export PI_LIFE="${life}"

  # Issue #11: overlay-defined skills (extra_skills + tracker.skill) become
  # --skill arguments so the model can actually use them, not just see them
  # in the prompt. Paths are resolved relative to $PWD; missing paths warn
  # (per-repo overlay is a per-project opt-in, not a fail-closed requirement).
  while IFS= read -r skill_path; do
    [[ -z "${skill_path}" ]] && continue
    add_overlay_skill overlay "${skill_path}"
  done < <(overlay_skill_paths "${PWD}")

  if [[ "${dry_run}" -eq 1 ]]; then
    printf 'pi'
    local arg
    for arg in "${pi_args[@]}"; do
      printf ' %q' "${arg}"
    done
    printf '\n'
    return 0
  fi

  if ! command -v pi >/dev/null 2>&1; then
    printf 'pi-life: pi not found on PATH\n' >&2
    exit 127
  fi

  exec pi "${pi_args[@]}"
}

main() {
  local dry_run=0
  if [[ "${1:-}" == "--dry-run" ]]; then
    dry_run=1
    shift
  fi

  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi
  if [[ "${1}" == "-h" || "${1}" == "--help" || "${1}" == "help" ]]; then
    if [[ $# -ne 1 ]]; then
      printf 'pi-life: unexpected argument: %s\n' "${2}" >&2
      usage >&2
      exit 2
    fi
    usage
    exit 0
  fi

  local root
  root="$(resolve_root)"

  case "${1}" in
    doctor)
      # Issue #13: doctor checks the launcher + optional packs. Exit 2 if a
      # required piece (pi, bun) is missing or the overlay fails to parse;
      # optional gaps (packs, just, rs-guard, excludesfile) warn, exit 0.
      if [[ $# -gt 2 ]]; then
        printf 'pi-life: unexpected argument: %s\n' "${3}" >&2
        usage >&2
        exit 2
      fi
      local doc_arg="${2:-}"
      local doc_life=""
      if [[ -n "${doc_arg}" ]]; then
        local doc_status=0
        doc_life="$(canonical_life "${doc_arg}")" || doc_status=$?
        if [[ "${doc_status}" -eq 2 ]]; then
          exit 2
        fi
        if [[ "${doc_status}" -ne 0 ]]; then
          printf 'pi-life: unknown life %s\n' "${doc_arg}" >&2
          usage >&2
          exit 2
        fi
        printf 'life: %s\n' "${doc_life}"
      fi
      printf 'harness: %s\n' "${root}"
      printf 'cwd: %s\n' "${PWD}"

      local overlay
      overlay="$(read_overlay "${PWD}")" || exit 2
      printf 'overlay: %s\n' "${overlay}"

      local missing=()
      command -v pi >/dev/null 2>&1 || missing+=("pi")
      command -v bun >/dev/null 2>&1 || missing+=("bun")
      if [[ ${#missing[@]} -gt 0 ]]; then
        printf 'required: FAIL missing: %s\n' "${missing[*]}"
        exit 2
      fi
      printf 'required: ok\n'

      local optional=0
      local skills_home="${PI_SKILLS_HOME:-${HOME}/.agents/skills}"
      if [[ -n "${doc_life}" ]]; then
        local doc_profile="${root}/profiles/${doc_life}.yaml"
        if [[ ! -f "${doc_profile}" ]]; then
          printf 'pi-life: missing profile %s\n' "${doc_profile}" >&2
          exit 2
        fi
        local kind name
        local profile_out profile_rc=0
        profile_out="$(read_profile "${doc_profile}" "${root}")" || profile_rc=$?
        if [[ "${profile_rc}" -ne 0 ]]; then
          exit 2
        fi
        while IFS=$'\t' read -r kind name; do
          [[ "${kind}" == "pack" ]] || continue
          if [[ ! -e "${skills_home}/${name}" ]]; then
            printf 'warning: missing pack %s (%s)\n' "${name}" "${skills_home}/${name}"
            optional=$((optional + 1))
          fi
        done <<< "${profile_out}"
      fi

      if ! command -v just >/dev/null 2>&1; then
        printf 'warning: just not on PATH\n'
        optional=$((optional + 1))
      fi
      if ! command -v rs-guard >/dev/null 2>&1; then
        printf 'warning: rs-guard not on PATH\n'
        optional=$((optional + 1))
      fi
      local ex_rc=0
      local ex_out
      ex_out="$(check_excludesfile 2>&1)" || ex_rc=$?
      if [[ "${ex_rc}" -ne 0 ]]; then
        printf 'warning: %s\n' "${ex_out}"
        optional=$((optional + 1))
      fi
      if [[ "${optional}" -eq 0 ]]; then
        printf 'optional: ok\n'
      else
        printf 'optional: %s warning(s)\n' "${optional}"
      fi
      exit 0
      ;;
    doctor-probe)
      if [[ $# -ne 1 ]]; then
        printf 'pi-life: unexpected argument: %s\n' "${2}" >&2
        usage >&2
        exit 2
      fi
      check_excludesfile
      exit $?
      ;;
    --dump-overlay)
      # Print the overlay for <cwd> as a single JSON line on stdout. Used by
      # smoke tests and by `pi-life doctor` (issue #13) to introspect the
      # resolved overlay without launching Pi. Exits 2 on bad YAML or schema.
      if [[ $# -ne 2 ]]; then
        printf 'pi-life: --dump-overlay requires a cwd argument\n' >&2
        usage >&2
        exit 2
      fi
      read_overlay "${2}"
      exit $?
      ;;
  esac

  local life status=0
  life="$(canonical_life "${1}")" || status=$?
  if [[ "${status}" -eq 2 ]]; then
    exit 2
  fi
  if [[ "${status}" -ne 0 ]]; then
    printf 'pi-life: unknown life %s\n' "${1}" >&2
    usage >&2
    exit 2
  fi

  if [[ $# -gt 2 ]]; then
    printf 'pi-life: unexpected argument: %s\n' "${3}" >&2
    usage >&2
    exit 2
  fi

  local mode="${2:-solo}"
  case "${mode}" in
    solo) ;;
    chain|team)
      printf 'pi-life: %s is accepted but not wired yet (#6/#8); using solo skill allowlist\n' "${mode}" >&2
      ;;
    *)
      printf 'pi-life: unknown mode %s\n' "${mode}" >&2
      usage >&2
      exit 2
      ;;
  esac

  launch_life "${root}" "${life}" "${mode}" "${dry_run}"
}

main "$@"
