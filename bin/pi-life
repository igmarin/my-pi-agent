#!/usr/bin/env bash
# Launch a Pi harness life from the target repo (cwd).
# INV-skills: always --no-skills, then --skill for allowlisted paths only.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pi-life [--dry-run] <life> [solo|chain|team]
       pi-life doctor
       pi-life --help

Lives: rust | elixir | ruby | python
Aliases: phoenix → elixir, rails → ruby

  solo   daily stack (default)
  chain  plan-build-review
  team   dispatcher
  doctor this machine + cwd overlay

Harness root: MY_PI_AGENT_HOME or the directory that contains this script.
Skills root: PI_SKILLS_HOME or ~/.agents/skills.
Run from the target repo. Does not require a justfile there.
EOF
}

resolve_root() {
  if [[ -n "${MY_PI_AGENT_HOME:-}" ]]; then
    printf '%s\n' "${MY_PI_AGENT_HOME}"
    return
  fi
  local src="${BASH_SOURCE[0]}"
  while [[ -L "${src}" ]]; do
    local dir
    dir="$(cd "$(dirname "${src}")" && pwd)"
    src="$(readlink "${src}")"
    [[ "${src}" != /* ]] && src="${dir}/${src}"
  done
  cd "$(dirname "${src}")/.." && pwd
}

canonical_life() {
  case "${1}" in
    rust) printf '%s\n' rust ;;
    elixir|phoenix) printf '%s\n' elixir ;;
    ruby|rails) printf '%s\n' ruby ;;
    python) printf '%s\n' python ;;
    rails-python)
      printf 'pi-life: rails-python is not a life; use ruby or python\n' >&2
      return 2
      ;;
    ecto)
      printf 'pi-life: ecto is not a life; use elixir\n' >&2
      return 2
      ;;
    *) return 1 ;;
  esac
}

# Top-level YAML strings for a key (scalar or sequence). Uses bun + yaml.
yaml_strings() {
  local file="$1" key="$2" root="$3"
  (
    cd "${root}"
    bun -e '
      import { parse } from "yaml";
      import { readFileSync } from "fs";
      const doc = parse(readFileSync(process.argv[1], "utf8")) ?? {};
      const v = doc[process.argv[2]];
      if (v == null) process.exit(0);
      const arr = Array.isArray(v) ? v : [v];
      for (const x of arr) {
        if (x != null && String(x) !== "") console.log(String(x));
      }
    ' "${file}" "${key}"
  )
}

warn_missing() {
  local kind="$1" name="$2" path="$3"
  printf 'pi-life: warning: missing %s %s (%s)\n' "${kind}" "${name}" "${path}" >&2
}

# Globals: skill_names, pi_args
add_named_skill() {
  local kind="$1" name="$2" skills_home="$3"
  [[ -z "${name}" ]] && return 0
  case " ${skill_names} " in
    *" ${name} "*) return 0 ;;
  esac
  skill_names="${skill_names} ${name}"

  local path="${skills_home}/${name}"
  if [[ -e "${path}" ]]; then
    pi_args+=(--skill "${path}")
  else
    warn_missing "${kind}" "${name}" "${path}"
  fi
}

load_list() {
  local kind="$1" file="$2" key="$3" skills_home="$4" root="$5"
  local name
  while IFS= read -r name; do
    add_named_skill "${kind}" "${name}" "${skills_home}"
  done < <(yaml_strings "${file}" "${key}" "${root}")
}

launch_life() {
  local root="$1" life="$2" mode="$3" dry_run="$4"
  local profile="${root}/profiles/${life}.yaml"
  if [[ ! -f "${profile}" ]]; then
    printf 'pi-life: missing profile %s\n' "${profile}" >&2
    exit 2
  fi

  if ! command -v bun >/dev/null 2>&1; then
    printf 'pi-life: bun not found on PATH (needed to read YAML profiles)\n' >&2
    exit 2
  fi

  local skills_home="${PI_SKILLS_HOME:-${HOME}/.agents/skills}"
  skill_names=""
  pi_args=(--no-skills)

  load_list skill "${profile}" "mantra" "${skills_home}" "${root}"
  load_list pack "${profile}" "packs" "${skills_home}" "${root}"

  local tracker=""
  tracker="$(yaml_strings "${profile}" "tracker" "${root}" | head -n 1 || true)"
  case "${tracker}" in
    "" | none) ;;
    *) add_named_skill skill "${tracker}" "${skills_home}" ;;
  esac

  export MY_PI_AGENT_HOME="${root}"
  export PI_LIFE="${life}"
  export PI_LIFE_MODE="${mode}"

  if [[ "${dry_run}" -eq 1 ]]; then
    printf 'pi'
    local arg
    for arg in "${pi_args[@]}"; do
      printf ' %q' "${arg}"
    done
    printf '\n'
    return 0
  fi

  if ! command -v pi >/dev/null 2>&1; then
    printf 'pi-life: pi not found on PATH\n' >&2
    exit 127
  fi

  exec pi "${pi_args[@]}"
}

main() {
  local dry_run=0
  case "${PI_LIFE_DRY_RUN:-}" in
    1 | true | yes) dry_run=1 ;;
  esac

  if [[ "${1:-}" == "--dry-run" ]]; then
    dry_run=1
    shift
  fi

  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi
  if [[ "${1}" == "-h" || "${1}" == "--help" || "${1}" == "help" ]]; then
    if [[ $# -ne 1 ]]; then
      printf 'pi-life: unexpected argument: %s\n' "${2}" >&2
      usage >&2
      exit 2
    fi
    usage
    exit 0
  fi

  local root
  root="$(resolve_root)"

  case "${1}" in
    doctor)
      if [[ $# -ne 1 ]]; then
        printf 'pi-life: unexpected argument: %s\n' "${2}" >&2
        usage >&2
        exit 2
      fi
      printf 'harness: %s\n' "${root}"
      printf 'cwd: %s\n' "${PWD}"
      printf 'doctor: not implemented yet (issue #13)\n' >&2
      exit 2
      ;;
  esac

  local life status=0
  life="$(canonical_life "${1}")" || status=$?
  if [[ "${status}" -eq 2 ]]; then
    exit 2
  fi
  if [[ "${status}" -ne 0 ]]; then
    printf 'pi-life: unknown life %s\n' "${1}" >&2
    usage >&2
    exit 2
  fi

  if [[ $# -gt 2 ]]; then
    printf 'pi-life: unexpected argument: %s\n' "${3}" >&2
    usage >&2
    exit 2
  fi

  local mode="${2:-solo}"
  case "${mode}" in
    solo|chain|team) ;;
    *)
      printf 'pi-life: unknown mode %s\n' "${mode}" >&2
      usage >&2
      exit 2
      ;;
  esac

  launch_life "${root}" "${life}" "${mode}" "${dry_run}"
}

main "$@"
