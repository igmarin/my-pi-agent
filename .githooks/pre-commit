#!/bin/sh
# rs-guard pre-commit hook
#
# Install:
#   git config core.hooksPath .githooks
#
# This hook analyzes staged changes with rs-guard and aborts the commit
# if the review returns REQUEST_CHANGES (exit code 2).
#
# Bypass the hook:
#   git commit --no-verify

# Run from the repository root so the prompt-file path is always correct.
cd "$(git rev-parse --show-toplevel 2>/dev/null || .)" || exit 1

# Load optional config file (sourced if it exists)
if [ -f "$HOME/.config/rs-guard/env" ]; then
    . "$HOME/.config/rs-guard/env"
fi

# The active provider in .reviewer.toml is "deepseek". If you change it,
# update this check to match the provider's API key environment variable.
if [ -z "$DEEPSEEK_API_KEY" ]; then
    echo "rs-guard: DEEPSEEK_API_KEY not found in environment. Skipping AI pre-commit review."
    exit 0
fi

# Skip if rs-guard is not installed
if ! command -v rs-guard >/dev/null 2>&1; then
    echo "rs-guard: not found in PATH. Skipping AI pre-commit review."
    exit 0
fi

# Skip if nothing is staged
if git diff --cached --quiet; then
    exit 0
fi

echo "Running rs-guard pre-commit review..."

rs-guard --prompt-file .github/review-prompt.md
EXIT_CODE=$?

if [ "$EXIT_CODE" -eq 0 ]; then
    echo "rs-guard: Review passed."
    exit 0
elif [ "$EXIT_CODE" -eq 2 ]; then
    echo "rs-guard: Review requested changes. Commit aborted."
    echo "Address the feedback above or bypass with: git commit --no-verify"
    exit 1
else
    echo "rs-guard: Error occurred (exit code $EXIT_CODE). Commit aborted."
    exit 1
fi
